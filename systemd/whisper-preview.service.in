[Unit]
Description=whisper.cpp preview server (tiny.en, warm, for the dictation live preview)

[Service]
ExecStart=@ENGINE_DIR@/whisper.cpp/build/bin/whisper-server -m @ENGINE_DIR@/whisper.cpp/models/ggml-tiny.en.bin --host 127.0.0.1 --port 8911 -t 8 -nt
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
